{
  "name": "dsh-thinking-tree",
  "version": "1.0.0",
  "description": "Tree-shaped chain of thought in the DeepSeek Harness right sidebar, enforced by the Host: per-step digest, first-turn gate, per-conversation memory bank, and one shared MCP/skill library.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "assets",
    "docs",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "memory.js",
    "enforce.js",
    "libraries.js"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "thinking",
    "chain-of-thought",
    "planning",
    "skill"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "license": "GPL-3.0-or-later"
}
